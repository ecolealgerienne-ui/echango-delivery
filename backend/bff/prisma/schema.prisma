// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Echango Merchant Account (not a Fleetbase User)
model MerchantAccount {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String   // bcrypted
  firstName         String?
  lastName          String?
  phone             String?
  emailVerified     Boolean  @default(false)
  emailVerifiedAt   DateTime?

  // Link to Fleetbase
  fleetbaseVendorUuid   String  @unique // Vendor UUID in Fleetbase
  fleetbaseCustomerUuid String? // Customer UUID in Fleetbase (for customer-portal)
  fleetbaseSanctumToken String? @db.Text // Sanctum token for customer-portal-api (encrypted at rest)

  // Business
  businessName      String
  businessPhone     String?

  // Status
  active            Boolean  @default(true)

  // Relations
  deviceTokens      DeviceToken[]
  orders            Order[]
  commissions       Commission[]

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastLoginAt       DateTime?

  @@index([fleetbaseVendorUuid])
  @@index([emailVerified])
}

// Fleet Manager Account (not a Fleetbase User either)
model FleetAccount {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String   // bcrypted
  firstName         String?
  lastName          String?
  phone             String?

  // Link to Fleetbase
  fleetbaseVendorUuid   String  @unique // Vendor UUID in Fleetbase

  // Business
  businessName      String
  businessPhone     String?

  // Status
  active            Boolean  @default(true)

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastLoginAt       DateTime?

  @@index([fleetbaseVendorUuid])
  @@index([active])
}

// Driver ("transporteur") Account - not a Fleetbase User either.
// Provisioning is manual (docs/specs_app_transporteur.md §2.1, §13 Q8): a real
// Driver record must already exist in Fleetbase (created by an Echango operator,
// e.g. via the flotte module or the Fleetbase console) before a driver can link
// an Echango account against it - registerDriver() verifies fleetbaseDriverUuid
// against a live Fleetbase Driver before creating this row.
model DriverAccount {
  id                    String   @id @default(cuid())
  email                 String   @unique
  password              String   // bcrypted
  firstName             String?
  lastName              String?
  phone                 String?

  // Link to Fleetbase
  fleetbaseDriverUuid   String   @unique // Driver UUID in Fleetbase
  fleetbaseUserUuid     String?          // Driver.user_uuid - push tokens route through
                                          // UserDevice (user_uuid), not the Driver record
                                          // itself (see docs/journal_implementation_bff.md)
  // Driver.public_id ("driver_xxxx"). Needed because POST /v1/orders/{id}/start
  // validates its `assign` param as a public_id and rejects a uuid - the one
  // place in the API that will not take the uuid.
  fleetbaseDriverPublicId String?

  // Status
  active                Boolean  @default(true)

  // Dernière position connue, miroir de ce que l'app vient d'envoyer à
  // Fleetbase. Fleetbase stocke bien l'historique des Position, mais son
  // endpoint /positions n'offre aucun filtre par driver : servir une carte de
  // flotte depuis lui oblige à télécharger tout l'historique de la compagnie
  // et à le trier en mémoire, à chaque rafraîchissement. Ces trois colonnes
  // donnent la seule chose dont la carte a besoin — le dernier point — sans
  // dupliquer l'historique, qui reste chez Fleetbase, source de vérité.
  lastLatitude          Float?
  lastLongitude         Float?
  lastPositionAt        DateTime?

  // Relations
  deviceTokens          DriverDeviceToken[]
  deliveryFailures      DeliveryFailure[]

  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lastLoginAt           DateTime?

  @@index([fleetbaseDriverUuid])
  @@index([active])
}

// Push Token for a Driver's device. Mirrored to a Fleetbase UserDevice record
// (see FleetbaseApiClient.upsertDriverDeviceToken) so native FCM/APN dispatch
// (OrderPing) can reach it directly - kept as its own model rather than reusing
// DeviceToken below, which is hard-wired to MerchantAccount.
model DriverDeviceToken {
  id                String   @id @default(cuid())
  driverId          String
  driver            DriverAccount @relation(fields: [driverId], references: [id], onDelete: Cascade)

  token             String   @unique
  platform          String   // 'ios' or 'android'
  appVersion        String?

  // UUID of the mirrored Fleetbase UserDevice record, once the write-through
  // succeeds. Null if the mirror failed or hasn't been attempted yet - the BFF
  // still works via REST polling either way, this only affects native push.
  fleetbaseUserDeviceUuid String?

  active            Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastUsedAt        DateTime?

  @@index([driverId])
  @@index([active])
}

// Invitation nominative permettant à un transporteur de créer son compte
// Echango et de le rattacher à son Driver Fleetbase.
//
// Pourquoi ce modèle existe (revue C2) : `POST /auth/transporteur/register`
// était public et n'exigeait aucune preuve de possession — il suffisait de
// connaître un `driver_assigned_uuid`, que n'importe quel commerçant lit sur
// sa propre commande, pour s'enregistrer À LA PLACE du transporteur et prendre
// ses courses. Le vrai driver se retrouvait alors bloqué, l'uuid étant marqué
// comme déjà lié.
//
// L'invitation rétablit ce que la décision de provisioning manuel supposait
// déjà (specs_app_transporteur.md §2.1) : c'est l'opérateur qui décide qui
// devient transporteur, pas le premier arrivé.
model DriverInvitation {
  id                  String   @id @default(cuid())

  // Jeton remis au transporteur hors bande (SMS, papier, oral).
  // Stocké haché : une fuite de la base ne doit pas livrer des invitations
  // utilisables, exactement comme pour un mot de passe.
  tokenHash           String   @unique

  // Driver Fleetbase auquel ce jeton donne droit — figé à l'émission, donc
  // non choisi par l'appelant au moment de l'inscription.
  fleetbaseDriverUuid String

  // Facultatif : restreint l'invitation à un email précis.
  email               String?

  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime @default(now())

  @@index([fleetbaseDriverUuid])
  @@index([expiresAt])
}

// Failed delivery reported by a driver (docs/specs_app_transporteur.md §4.3).
//
// Stored here rather than in Fleetbase because whether a per-waypoint "failed"
// status exists natively is still unverified (§4.3 flags it as to-confirm, and
// nothing in the routes or the Activity model contradicts that). Until it is,
// the BFF is the source of truth for the failure itself; what we do push to
// Fleetbase is the operator-visible trace (photo proof + remarks), so a
// dispatcher looking at the order sees something rather than silence.
model DeliveryFailure {
  id                String   @id @default(cuid())
  driverId          String
  driver            DriverAccount @relation(fields: [driverId], references: [id], onDelete: Cascade)

  fleetbaseOrderUuid String
  waypointUuid      String?  // which stop failed, when the order has several

  reason            String   // see DeliveryFailureReason in the DTO
  notes             String?

  // Référence de la Proof créée dans Fleetbase quand une photo est jointe.
  // Null si le signalement était sans photo, ou si l'upload a échoué.
  //
  // ⚠️ Malgré son nom, ce n'est PAS toujours un uuid : la ressource Proof
  // masque `uuid` hors requête interne, et l'upload passe par l'API publique
  // `v1`, qui n'expose que `id` — le public_id. Référence opaque, jamais
  // utilisée pour adresser une route.
  fleetbaseProofUuid String?

  // URL du fichier, telle que Fleetbase la renvoie à la capture (`url` sur la
  // ressource Proof). Conservée à l'écriture plutôt que relue à chaque
  // affichage : la retrouver ensuite imposerait un appel par signalement, et
  // Fleetbase n'offre pas de lecture de Proof par uuid sur `int/v1`.
  proofUrl          String?

  reportedAt        DateTime @default(now())

  @@index([driverId])
  @@index([fleetbaseOrderUuid])
}

// Device Token for Push Notifications
model DeviceToken {
  id                String   @id @default(cuid())
  merchantId        String
  merchant          MerchantAccount @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  token             String   @unique
  platform          String   // 'ios' or 'android'
  appVersion        String?

  active            Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastUsedAt        DateTime?

  @@index([merchantId])
  @@index([active])
}

// Order Representation (cached from Fleetbase, for quick access)
model Order {
  id                String   @id @default(cuid())
  merchantId        String
  merchant          MerchantAccount @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  // Reference to Fleetbase
  fleetbaseOrderId  String   @unique

  // Order details
  status            String   // 'pending', 'active', 'completed', 'failed', 'cancelled'
  trackingNumber    String?

  // Failure details
  failureReason     String?
  failureNotes      String?

  // Commission tracking
  totalAmount       Float?   // In currency units
  commission        Float?   // Calculated by BFF

  // Timestamps (synced from Fleetbase)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  fleetbaseCreatedAt DateTime?
  fleetbaseUpdatedAt DateTime?

  // Relations
  commissions       Commission[]

  @@index([merchantId])
  @@index([fleetbaseOrderId])
  @@index([status])
}

// Commission Ledger (for analytics + future payouts)
model Commission {
  id                String   @id @default(cuid())
  merchantId        String
  merchant          MerchantAccount @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  orderId           String
  order             Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Commission calculation
  orderAmount       Float
  commissionType    String   // 'percentage', 'fixed', 'distance', 'hybrid'
  commissionAmount  Float

  // Details for audit
  calculatedAt      DateTime @default(now())
  calculatedBy      String   // 'system', 'manual', etc.

  // Payment status (if integrated with payouts)
  paidAt            DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([merchantId])
  @@index([orderId])
  @@index([paidAt])
}

// Audit Log (for security, traceability)
model AuditLog {
  id                String   @id @default(cuid())

  // Who (if any)
  merchantId        String?
  fleetId           String?

  // What
  action            String   // 'order.created', 'order.assigned', etc.
  resourceType      String   // 'Order', 'Driver', etc.
  resourceId        String?

  // Details
  details           String?  @db.Text // JSON stringified
  ipAddress         String?
  userAgent         String?

  // Status
  status            String   // 'success', 'failure'
  errorMessage      String?

  createdAt         DateTime @default(now())

  @@index([merchantId])
  @@index([fleetId])
  @@index([action])
  @@index([createdAt])
}
