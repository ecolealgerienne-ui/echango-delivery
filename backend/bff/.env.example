# Application
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Database (BFF-specific, for accounts, commissions, etc.)
DATABASE_URL=postgresql://bff_user:bff_password@localhost:5432/echango_bff

# Fleetbase Configuration
# No /api prefix: Fleetbase's core routes (int/v1/...) live at the domain root.
FLEETBASE_API_URL=http://localhost:8000
# Must be a Sanctum personal access token for a dedicated Fleetbase User (service account),
# e.g. $user->createToken('bff-service-account')->plainTextToken.
# NOT the "platform API key" (flb_live_/flb_test_) from Developers > API Keys — that key only
# authorizes a couple of narrow platform-api routes (v1/organizations, order update-activity),
# not general vendor/customer/order CRUD, which requires auth:sanctum.
FLEETBASE_API_KEY=your_fleetbase_sanctum_personal_access_token_here
FLEETBASE_ORGANIZATION_UUID=your_org_uuid_here

# JWT/Auth
# OBLIGATOIRE, 32 caractères minimum. Le service REFUSE de démarrer sans lui,
# ou avec l'une des valeurs de repli qui traînaient dans le dépôt (donc
# publiques). En générer un :  openssl rand -base64 48
JWT_SECRET=
# Durée de validité du jeton, en SECONDES (86400 = 24 h).
JWT_EXPIRATION=86400

# Taille maximale du corps des requêtes. Les preuves de livraison transitent
# en base64 : la valeur par défaut d'Express (100 ko) rejetait toute vraie
# photo de téléphone.
MAX_REQUEST_BODY=10mb

# Firebase Cloud Messaging (for push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Email (for merchant registration verification)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USER=your_mail_user
MAIL_PASSWORD=your_mail_password
MAIL_FROM=noreply@echango.local

# Application URLs
APP_URL=http://localhost:3001
MERCHANT_APP_URL=http://localhost:3000/merchant
FLEET_APP_URL=http://localhost:3000/fleet

# Base publique de CE service, utilisée pour construire des liens envoyés à des
# tiers hors de l'application — aujourd'hui le lien de localisation client
# (docs/specs_localisation_client_et_optimisation_parcours.md §1.2), partagé
# par le commerçant via SMS/WhatsApp. Sans valeur, le service se rabat sur
# http://localhost:3001 — correct en développement, mais OBLIGATOIRE en
# production (NODE_ENV=production) : le service refuse de démarrer sans elle,
# plutôt que de générer silencieusement des liens inutilisables hors de ce
# serveur. Poser l'URL publique réelle, ex. https://livraison.echango.dz
PUBLIC_URL=

# Stockage des preuves de livraison (photos).
# Contourne un bug amont : Fleetbase lit le bucket depuis la REQUÊTE au lieu de
# sa config, et se rabat sur le bucket S3 — null sans S3, ce qui fait échouer
# tout upload en 500. Voir docs/journal_implementation_bff.md §6.12.
# Laisser ainsi pour un stockage local ; renseigner pour un déploiement S3.
FLEETBASE_PROOF_DISK=local
FLEETBASE_PROOF_BUCKET=

# ── Dispatch ────────────────────────────────────────────────────────────────
# Rayon de diffusion d'une course adhoc, en mètres. Porté nativement par
# Fleetbase (colonne `adhoc_distance`) : c'est son dispatch géospatial qui
# l'applique, pas le BFF.
# Défaut : 15000 (15 km) — un repli, pas une décision produit. À régler au
# pilote avec de vraies distances.
ADHOC_RADIUS_METRES=15000

# ── Réconciliation des commandes ────────────────────────────────────────────
# Le BFF interroge périodiquement Fleetbase pour détecter ce qui a changé sur
# les commandes en cours, met à jour son cache et notifie le commerçant.
#
# Pourquoi une interrogation périodique : Fleetbase n'appelle pas le BFF, et
# les évènements qui intéressent le commerçant surviennent parfois hors de nos
# routes (un opérateur qui assigne depuis la console). Les webhooks Fleetbase
# sont la bonne cible à l'échelle — ils supposent une URL joignable et une
# vérification de signature, prérequis de mise en production.
#
# `false` coupe le mécanisme : les commerçants ne sont alors notifiés de rien,
# et le statut en cache redevient figé. Le service le dit au démarrage.
RECONCILER_ENABLED=true
# Intervalle entre deux passages, en millisecondes. Plancher à 10000 : en
# dessous, un passage n'a pas fini que le suivant démarre.
RECONCILER_INTERVAL_MS=60000

# ── Paiement à la livraison ─────────────────────────────────────────────────
# Modèle retenu (docs/specs_paiement_livraison.md §6, Voie B) : le transporteur
# encaisse et CONSERVE les espèces ; l'application tient le registre de ce qu'il
# doit à chaque commerçant ; la remise est physique entre eux et se confirme des
# deux côtés. Echango ne touche jamais l'argent — ce qui évite d'emblée la
# question du statut de détenteur de fonds pour compte de tiers.
#
# Plafond de dette d'un transporteur envers UN commerçant, dans la devise de
# l'organisation. Au-delà, plus aucune course encaissée ne lui est confiée pour
# ce commerçant tant qu'il n'a pas remis.
#
# ⚠️ C'est le garde-fou principal du modèle : sans dépôt physique, cesser de
# confier des espèces à qui en doit déjà trop est le SEUL instrument de
# limitation du risque disponible. La valeur par défaut (20000) est un ordre de
# grandeur, pas un arbitrage — à fixer au pilote avec de vrais paniers.
COD_DEBT_CEILING=20000

# Ce qu'une même PERSONNE peut détenir, toutes contreparties confondues.
#
# Depuis la multi-appartenance (31/07/2026), un conducteur rattaché à trois
# entreprises porte trois dettes distinctes — donc trois fois le plafond
# ci-dessus, dans une seule poche. Ce second plafond ferme ce contournement.
#
# Non renseigné, il vaut COD_DEBT_CEILING : un conducteur ne détient jamais plus
# que le plafond, quel que soit le nombre d'entreprises pour lesquelles il roule.
#
# ⚠️ Ne s'applique QU'AUX CONDUCTEURS. L'appliquer à une entreprise la bornait,
# tous commerçants confondus, à ce qu'un indépendant isolé peut détenir — un
# plafond qui bloque l'exploitation ne protège rien, il fait désactiver le
# garde-fou. Le plafond d'exposition d'une entreprise est une question ouverte.
COD_DEBT_CEILING_PER_PERSON=20000

# ⚠️ `COD_FAVOURITES_ONLY` a été SUPPRIMÉ (29/07/2026). Il réservait les courses
# encaissées aux favoris du commerçant, au motif qu'on ne confie pas d'espèces à
# un inconnu. Le raisonnement supposait un pool anonyme — il ne l'est pas : les
# transporteurs sont sélectionnés et provisionnés par Echango sur invitation
# nominative, aucun ne s'inscrit de lui-même. Le contrôle a donc déjà eu lieu à
# l'entrée du réseau, et le refaire par commerçant interdisait l'encaissement à
# tout nouveau commerçant sans rien protéger de plus.

# Commission d'Echango, en fraction de la RÉMUNÉRATION du transporteur (0.2 =
# 20 %). Jamais sur le montant encaissé : celui-ci appartient au commerçant et
# ne fait que transiter — prélever dessus reviendrait à taxer la marchandise de
# quelqu'un d'autre.
#
# ⚠️ Son RECOUVREMENT n'est pas construit : facturer un transporteur est un acte
# de gestion, pas une fonctionnalité de l'application. Ce qui est fait ici, et
# qui ne se rattrape pas, c'est le calcul et son enregistrement au moment de la
# course, avec le taux qui s'appliquait alors.
#
# 20 % par défaut : un ordre de grandeur volontairement sous le secteur
# (Uber, Stuart, Yassir : 25-30 %) pour un réseau qui doit attirer des
# transporteurs. Pas un arbitrage.
COMMISSION_RATE=0.2

# ── Géocodage — service transverse echango-geo ─────────────────────────────
# Depuis le 05/09/2026, le BFF n'appelle plus Nominatim directement : il passe
# par echango-geo (Nominatim auto-hébergé, mutualisé avec le CRM). Voir
# echango-geo/docs/specs_echango_geo_v1.md.
#
# echango-geo n'est pas exposé publiquement : joignable seulement sur le
# réseau Docker interne (echango_network), par son nom de service.
GEO_SERVICE_URL=http://geo-api:3000
# Jeton partagé exigé dans l'en-tête X-Internal-Token (défense en profondeur
# derrière la frontière réseau). Doit correspondre au GEO_INTERNAL_TOKEN
# configuré côté echango-geo.
GEO_INTERNAL_TOKEN=
# Délai (ms) avant de rendre geocoding.unavailable (503).
GEO_SERVICE_TIMEOUT_MS=12000
# Pays transmis à echango-geo : sans lui, « rue de la Liberté » remonte
# d'abord des résultats européens.
GEOCODING_COUNTRY=dz

# Devise des montants proposés par les commerçants. Accompagne toujours le
# montant : un nombre nu se lit différemment selon le lecteur.
CURRENCY=DZD

# ── Tarification ────────────────────────────────────────────────────────────
# `merchant` : le commerçant propose le montant, la plateforme le relaie.
#              C'est le mode actuel, le barème n'étant pas tranché.
# `computed` : montant calculé par la plateforme. La formule n'est PAS encore
#              implémentée — basculer maintenant retombe sur le montant proposé
#              et journalise un avertissement.
#
# Les entrées de la future formule (distance, horaire, catégorie de véhicule)
# sont capturées sur CHAQUE commande quel que soit le mode : elles ne sont pas
# rattrapables après coup, et sans elles les courses du pilote ne serviront pas
# à calibrer le barème.
PRICING_MODE=merchant

# Nombre de proxys entre Internet et ce processus (1 pour un nginx unique), ou
# une liste d'adresses de confiance.
#
# ⚠️ Ne JAMAIS mettre `true`. Sans cette variable, `req.ip` est l'adresse de la
# socket — juste en développement. Avec `true`, n'importe quel client forge son
# `X-Forwarded-For` et le plafond anti-force-brute de /auth/login disparaît
# purement. Avec un nombre, Express ne retient que le saut correspondant.
#
# Absente ⇒ derrière un proxy, tous les clients partagent une seule adresse et
# six requêtes coupent l'authentification de toute la plateforme.
# TRUST_PROXY=1
